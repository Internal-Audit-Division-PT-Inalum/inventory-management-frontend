{
  "name": "inventory-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "Inventory Management System Mobile PWA - Divisi Internal Audit PT INALUM",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "format": "biome format --write ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "check": "biome check --write ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "biome check ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts && npm run typecheck && vitest run && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
